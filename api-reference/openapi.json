components:
  schemas:
    APIToken:
      type: object
      description: Safe key metadata. The secret is never part of it — see APITokenCreatedSerializer.
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          description: Token name/description
          maxLength: 255
        type:
          allOf:
          - $ref: '#/components/schemas/Type1c2Enum'
          readOnly: true
        prefix:
          type: string
          readOnly: true
          description: First characters of the secret, shown so a key can be recognised.
        user_id:
          type: string
          readOnly: true
          nullable: true
        service_account_id:
          type: string
          readOnly: true
          nullable: true
        organization:
          type: string
          format: uuid
          nullable: true
          description: Limit the key to one organization. Implied by `project`.
        project:
          type: string
          format: uuid
          nullable: true
          description: Bind the key to one project (recommended). Requests with a
            bound key need no Sophy-Project header.
        scopes:
          type: array
          items:
            $ref: '#/components/schemas/PermissionEnum'
          description: Limit the key to these permissions. Empty = the owner's permissions.
            A key never exceeds its owner, whatever its scopes say.
        is_active:
          type: boolean
          readOnly: true
        revoked_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        expires_at:
          type: string
          format: date-time
          nullable: true
          description: Token expiration date. Leave blank for unlimited.
        last_used_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        is_expired:
          type: boolean
          readOnly: true
        is_valid:
          type: boolean
          readOnly: true
        is_legacy:
          type: boolean
          readOnly: true
          description: Issued by the old key system; deprecated, to be replaced with
            a new key.
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - is_active
      - is_expired
      - is_legacy
      - is_valid
      - last_used_at
      - name
      - prefix
      - revoked_at
      - service_account_id
      - type
      - updated_at
      - user_id
    APITokenCreated:
      type: object
      description: 'Returned once, on creation: the only response that carries the
        secret.'
      properties:
        token:
          type: string
          readOnly: true
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          description: Token name/description
          maxLength: 255
        type:
          allOf:
          - $ref: '#/components/schemas/Type1c2Enum'
          readOnly: true
        prefix:
          type: string
          readOnly: true
          description: First characters of the secret, shown so a key can be recognised.
        user_id:
          type: string
          readOnly: true
          nullable: true
        service_account_id:
          type: string
          readOnly: true
          nullable: true
        organization:
          type: string
          format: uuid
          nullable: true
          description: Limit the key to one organization. Implied by `project`.
        project:
          type: string
          format: uuid
          nullable: true
          description: Bind the key to one project (recommended). Requests with a
            bound key need no Sophy-Project header.
        scopes:
          type: array
          items:
            $ref: '#/components/schemas/PermissionEnum'
          description: Limit the key to these permissions. Empty = the owner's permissions.
            A key never exceeds its owner, whatever its scopes say.
        is_active:
          type: boolean
          readOnly: true
        revoked_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        expires_at:
          type: string
          format: date-time
          nullable: true
          description: Token expiration date. Leave blank for unlimited.
        last_used_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        is_expired:
          type: boolean
          readOnly: true
        is_valid:
          type: boolean
          readOnly: true
        is_legacy:
          type: boolean
          readOnly: true
          description: Issued by the old key system; deprecated, to be replaced with
            a new key.
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - is_active
      - is_expired
      - is_legacy
      - is_valid
      - last_used_at
      - name
      - prefix
      - revoked_at
      - service_account_id
      - token
      - type
      - updated_at
      - user_id
    AgentAction:
      type: object
      description: |-
        An AgentAction as Studio shows it. ``key`` is left out on purpose: it names
        the provider ("vapi:<tool call id>"); ``id`` is the action's id everywhere.
      properties:
        id:
          type: string
        type:
          type: string
        status:
          $ref: '#/components/schemas/Status520Enum'
        project_id:
          type: string
        agent_id:
          type: string
        agent_name:
          type: string
        source:
          type: object
          additionalProperties: {}
        customer:
          type: object
          additionalProperties: {}
          readOnly: true
        data:
          type: object
          additionalProperties: {}
        steps:
          type: array
          items:
            type: object
            additionalProperties: {}
        history:
          type: array
          items:
            type: object
            additionalProperties: {}
        needs_retry:
          type: boolean
          readOnly: true
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
          format: date-time
      required:
      - agent_id
      - agent_name
      - created_at
      - customer
      - data
      - history
      - id
      - needs_retry
      - project_id
      - source
      - status
      - steps
      - type
      - updated_at
    AgentActionStatus:
      type: object
      properties:
        status:
          $ref: '#/components/schemas/Status520Enum'
        note:
          type: string
          default: ''
      required:
      - status
    AnalyticsCapabilities:
      type: object
      properties:
        calls:
          type: boolean
        conversations:
          type: boolean
        campaigns:
          type: boolean
      required:
      - calls
      - campaigns
      - conversations
    AnalyticsQuery:
      type: object
      properties:
        name:
          type: string
        source:
          type: string
        step:
          type: string
          nullable: true
        group_by:
          type: array
          items:
            type: string
        measures:
          type: array
          items:
            type: string
          minItems: 1
        filters:
          type: object
          additionalProperties: {}
        top_n:
          type: integer
          minimum: 1
          nullable: true
      required:
      - measures
      - name
      - source
    AnalyticsRequest:
      type: object
      description: |-
        Shape only — every semantic/enum check (is `source` known, is a
        `group_by` member valid for that source, ...) lives in
        analytics/services/query.py:validate_request(), not here, since the
        valid sets are source-dependent rather than a fixed choice list.
      properties:
        timezone:
          type: string
          nullable: true
        range:
          type: object
          additionalProperties: {}
          nullable: true
        queries:
          type: array
          items:
            $ref: '#/components/schemas/AnalyticsQuery'
      required:
      - queries
    AnalyticsResponse:
      type: object
      properties:
        timezone:
          type: string
        range:
          type: object
          additionalProperties: {}
        capabilities:
          $ref: '#/components/schemas/AnalyticsCapabilities'
        results:
          type: array
          items:
            $ref: '#/components/schemas/AnalyticsResult'
      required:
      - capabilities
      - range
      - results
      - timezone
    AnalyticsResult:
      type: object
      properties:
        name:
          type: string
        group_by:
          type: array
          items:
            type: string
        rows:
          type: array
          items:
            type: object
            additionalProperties: {}
        error:
          type: string
          nullable: true
      required:
      - name
    AnalyticsValidationError:
      type: object
      properties:
        errors:
          type: array
          items:
            type: object
            additionalProperties: {}
      required:
      - errors
    AutoLabeling:
      type: object
      properties:
        enabled:
          type: boolean
        idle_minutes:
          type: integer
          minimum: 1
          description: Label a conversation only after this many minutes without activity.
            Defaults to 30.
        existing_transcripts:
          $ref: '#/components/schemas/ExistingTranscripts'
    BlankEnum:
      enum:
      - ''
    CallDetail:
      type: object
      description: 'A single call: ledger row plus its stored report.'
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        project_id:
          type: string
          format: uuid
          readOnly: true
        channel_id:
          type: string
          format: uuid
          readOnly: true
        channel_name:
          type: string
          readOnly: true
        platform_type:
          type: string
          description: Denormalized from channel for reporting.
          maxLength: 50
        direction:
          $ref: '#/components/schemas/DirectionEnum'
        origin:
          $ref: '#/components/schemas/OriginEnum'
        provider_call_id:
          type: string
          nullable: true
          description: Provider-side call id (VAPI call.id). Null until dispatched.
          maxLength: 255
        from_number:
          type: string
          maxLength: 64
        to_number:
          type: string
          maxLength: 64
        agent_id:
          type: integer
          nullable: true
          readOnly: true
        agent_name:
          type: string
          readOnly: true
        agent_ref:
          type: string
          nullable: true
          description: Raw provider assistant id — survives agent deletion.
          maxLength: 255
        run_id:
          type: string
          format: uuid
          nullable: true
          readOnly: true
        campaign_id:
          type: string
          format: uuid
          readOnly: true
        campaign_name:
          type: string
          readOnly: true
        contact_id:
          type: string
          format: uuid
          nullable: true
          readOnly: true
        run_attempt_no:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
        external_ref:
          type: string
          description: Customer's record id the call was started from (e.g. an order
            / transaction id typed in Studio).
          maxLength: 128
        initiated_by_id:
          type: integer
          nullable: true
          description: Who confirmed and started this call in Studio.
          readOnly: true
        initiated_by_name:
          type: string
          nullable: true
          readOnly: true
          description: Who confirmed and started the call in Studio; null otherwise.
        confirmed_at:
          type: string
          format: date-time
          nullable: true
          description: When the starter completed the second confirmation step.
        result:
          nullable: true
          readOnly: true
          description: The campaign's chosen structured-output value (Campaign.result_field),
            e.g. a confirmation verdict. Null when unset or not reported yet.
        state:
          $ref: '#/components/schemas/StateFf0Enum'
        outcome:
          nullable: true
          oneOf:
          - $ref: '#/components/schemas/OutcomeEnum'
          - $ref: '#/components/schemas/BlankEnum'
          - $ref: '#/components/schemas/NullEnum'
        end_reason_raw:
          type: string
          nullable: true
          description: Provider's raw endedReason, stored verbatim.
          maxLength: 255
        started_at:
          type: string
          format: date-time
          nullable: true
        ended_at:
          type: string
          format: date-time
          nullable: true
        last_attempt_at:
          type: string
          format: date-time
