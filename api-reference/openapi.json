openapi: 3.0.3
info:
  title: Sophy Communication Platform API
  version: 1.0.0
  description: REST API for authentication, token management, and transcript/dialogue
    retrieval
paths:
  /api/auth/login/:
    post:
      operationId: auth_login_create
      description: User login endpoint. Returns JWT access + refresh tokens.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Login'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Login'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Login'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Login'
          description: ''
  /api/auth/logout/:
    post:
      operationId: auth_logout_create
      description: Blacklists the refresh token, invalidating the session.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LogoutRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LogoutRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LogoutRequest'
        required: true
      security:
      - jwtAuth: []
      - tokenAuth: []
      responses:
        '204':
          description: No response body
  /api/auth/token/refresh/:
    post:
      operationId: auth_token_refresh_create
      description: Returns a new access token given a valid refresh token.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RefreshTokenRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/RefreshTokenRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/RefreshTokenRequest'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RefreshTokenResponse'
          description: ''
  /api/auth/tokens/:
    get:
      operationId: auth_tokens_list
      description: |-
        API Token management for authenticated users.
        Users can create, list, update, and delete their own tokens.
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - auth
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAPITokenList'
          description: ''
    post:
      operationId: auth_tokens_create
      description: |-
        API Token management for authenticated users.
        Users can create, list, update, and delete their own tokens.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/APIToken'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/APIToken'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/APIToken'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/APIToken'
          description: ''
  /api/auth/tokens/{id}/:
    get:
      operationId: auth_tokens_retrieve
      description: |-
        API Token management for authenticated users.
        Users can create, list, update, and delete their own tokens.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this api token.
        required: true
      tags:
      - auth
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/APIToken'
          description: ''
    patch:
      operationId: auth_tokens_partial_update
      description: |-
        API Token management for authenticated users.
        Users can create, list, update, and delete their own tokens.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this api token.
        required: true
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedAPIToken'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedAPIToken'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedAPIToken'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/APIToken'
          description: ''
    delete:
      operationId: auth_tokens_destroy
      description: |-
        API Token management for authenticated users.
        Users can create, list, update, and delete their own tokens.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this api token.
        required: true
      tags:
      - auth
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/billing/callback/{gateway}/:
    post:
      operationId: billing_callback_create
      parameters:
      - in: path
        name: gateway
        schema:
          type: string
        description: Payment gateway name (e.g. paytr)
        required: true
      tags:
      - Billing
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GatewayCallback'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/GatewayCallback'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/GatewayCallback'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
                description: Unspecified response body
          description: ''
  /api/billing/payments/{id}/:
    get:
      operationId: billing_payments_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: Payment ID (UUID)
        required: true
      tags:
      - Billing
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'
          description: ''
  /api/billing/payments/{id}/methods/:
    get:
      operationId: billing_payments_methods_retrieve
      description: Cards the payer may reuse for this invoice, most recent first.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Billing
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaymentMethodList'
          description: ''
  /api/billing/payments/{id}/methods/{method_id}/:
    delete:
      operationId: billing_payments_methods_destroy
      description: |-
        Remove a stored card, at the gateway and here.

        The row is deleted outright rather than deactivated. Its token is dead at
        the gateway, and a dormant row would be found again by the get_or_create in
        process_callback if the customer re-added the same card — the gateway
        reissues the same ctoken — leaving them with a card they just added that no
        listing shows. Both FKs to it are SET_NULL, so past invoices keep their
        metadata['card'] copy (written when the card was attached) and any
        subscription on it falls back to the checkout-link flow on the next run.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      - in: path
        name: method_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Billing
      security:
      - {}
      responses:
        '204':
          description: No response body
  /api/billing/payments/{id}/profile/:
    get:
      operationId: billing_payments_profile_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Billing
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BillingProfile'
          description: ''
    post:
      operationId: billing_payments_profile_create
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Billing
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/BillingProfile'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/BillingProfile'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/BillingProfile'
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BillingProfile'
          description: ''
  /api/billing/payments/{id}/token/{gateway}/:
    post:
      operationId: billing_payments_token_create
      parameters:
      - in: path
        name: gateway
        schema:
          type: string
        required: true
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Billing
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
                description: Unspecified response body
          description: ''
  /api/billing/payments/{id}/token/{gateway}/saved-card/:
    post:
      operationId: billing_payments_token_saved_card_create
      description: |-
        Form fields for paying this invoice with one of its saved cards.

        The checkout posts the response to its 'action' URL; PayTR then takes the
        cardholder through 3DS and redirects to merchant_ok_url / merchant_fail_url.
        The card is named by PaymentMethod id — the gateway token is filled in here,
        never sent to the client.
      parameters:
      - in: path
        name: gateway
        schema:
          type: string
        required: true
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Billing
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SavedCardToken'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/SavedCardToken'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/SavedCardToken'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
                description: Unspecified response body
          description: ''
  /api/billing/payments/{session_id}/session/:
    get:
      operationId: billing_payments_session_retrieve
      parameters:
      - in: path
        name: session_id
        schema:
          type: string
        description: Payment session ID (e.g. SPUU4V61XFW3)
        required: true
      tags:
      - Billing
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'
          description: ''
  /api/calls/{project_id}/:
    get:
      operationId: calls_list
      description: List calls in a project, newest first.
      parameters:
      - in: query
        name: agent_id
        schema:
          type: string
          format: uuid
      - in: query
        name: campaign_id
        schema:
          type: string
          format: uuid
      - in: query
        name: channel_id
        schema:
          type: string
          format: uuid
      - in: query
        name: contact_id
        schema:
          type: string
          format: uuid
      - in: query
        name: date_from
        schema:
          type: string
          format: date-time
      - in: query
        name: date_to
        schema:
          type: string
          format: date-time
      - in: query
        name: direction
        schema:
          type: string
        description: inbound | outbound
      - in: query
        name: has_recording
        schema:
          type: boolean
      - in: query
        name: limit
        schema:
          type: integer
        description: Max results to return (default 100, max 1000)
      - in: query
        name: number
        schema:
          type: string
        description: Substring match on either number
      - in: query
        name: offset
        schema:
          type: integer
        description: Number of items to skip (default 0)
      - in: query
        name: origin
        schema:
          type: string
        description: inbound | campaign | manual | api
      - in: query
        name: outcome
        schema:
          type: string
      - in: query
        name: platform_type
        schema:
          type: string
      - in: path
        name: project_id
        schema:
          type: string
          format: uuid
        description: Project UUID
        required: true
      - in: query
        name: run_id
        schema:
          type: string
          format: uuid
      - in: query
        name: state
        schema:
          type: string
      tags:
      - calls
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedCallList'
          description: ''
  /api/calls/{project_id}/{call_id}/:
    get:
      operationId: calls_retrieve
      description: Retrieve one call, with its stored report.
      parameters:
      - in: path
        name: call_id
        schema:
          type: string
          format: uuid
        description: Call UUID
        required: true
      - in: path
        name: project_id
        schema:
          type: string
          format: uuid
        description: Project UUID
        required: true
      tags:
      - calls
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CallDetail'
          description: ''
  /api/calls/{project_id}/{call_id}/messages/:
    get:
      operationId: calls_messages
      description: The turn-by-turn conversation for a call.
      parameters:
      - in: path
        name: call_id
        schema:
          type: string
          format: uuid
        description: Call UUID
        required: true
      - in: query
        name: limit
        schema:
          type: integer
      - in: query
        name: offset
        schema:
          type: integer
      - in: path
        name: project_id
        schema:
          type: string
          format: uuid
        description: Project UUID
        required: true
      tags:
      - calls
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedCallMessageList'
          description: ''
  /api/calls/{project_id}/{call_id}/replay/:
    post:
      operationId: calls_replay
      description: |-
        Re-run the post-call workflow for a call from its stored report.

        Side-effecting: this re-sends the report email. Nothing is recomputed from
        the provider — the stored report is replayed through the same entry point
        the webhook uses, so recording storage and email happen exactly as they did
        the first time.
      parameters:
      - in: path
        name: call_id
        schema:
          type: string
          format: uuid
        description: Call UUID
        required: true
      - in: path
        name: project_id
        schema:
          type: string
          format: uuid
        description: Project UUID
        required: true
      tags:
      - calls
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CallReplayRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CallReplayRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CallReplayRequest'
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '202':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CallReplayAccepted'
          description: ''
        '404':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CallReplayNoReport'
          description: ''
  /api/calls/{project_id}/numbers/{number}/:
    get:
      operationId: calls_number_history
      description: 'Everything that ever happened on one number: the rollup plus every
        attempt.'
      parameters:
      - in: query
        name: limit
        schema:
          type: integer
      - in: path
        name: number
        schema:
          type: string
        description: Phone number in E.164
        required: true
      - in: query
        name: offset
        schema:
          type: integer
      - in: path
        name: project_id
        schema:
          type: string
          format: uuid
        description: Project UUID
        required: true
      tags:
      - calls
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/NumberCallHistory'
          description: ''
  /api/calls/{project_id}/summary/:
    get:
      operationId: calls_summary
      description: Aggregate KPIs for a project's calls. Computed in the DB, not in
        Python.
      parameters:
      - in: query
        name: campaign_id
        schema:
          type: string
          format: uuid
      - in: query
        name: date_from
        schema:
          type: string
          format: date-time
      - in: query
        name: date_to
        schema:
          type: string
          format: date-time
      - in: query
        name: direction
        schema:
          type: string
      - in: query
        name: group_by
        schema:
          type: string
        description: day | outcome | state | channel | campaign (omit for totals only)
      - in: query
        name: origin
        schema:
          type: string
      - in: path
        name: project_id
        schema:
          type: string
          format: uuid
        description: Project UUID
        required: true
      tags:
      - calls
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CallSummary'
          description: ''
  /api/campaigns/{project_id}/:
    get:
      operationId: campaigns_list
      description: List campaigns in a project.
      parameters:
      - in: path
        name: project_id
        schema:
          type: string
          format: uuid
        description: Project UUID
        required: true
      tags:
      - campaigns
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Campaign'
          description: ''
  /api/campaigns/{project_id}/{campaign_id}/:
    get:
      operationId: campaigns_retrieve
      description: Retrieve a single campaign.
      parameters:
      - in: path
        name: campaign_id
        schema:
          type: string
          format: uuid
        description: Campaign UUID
        required: true
      - in: path
        name: project_id
        schema:
          type: string
          format: uuid
        description: Project UUID
        required: true
      tags:
      - campaigns
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Campaign'
          description: ''
  /api/campaigns/{project_id}/{campaign_id}/preview/:
    post:
      operationId: campaigns_preview_create
      description: 'Dry-run: who would be dialed, with which vars. Nothing is dispatched.'
      parameters:
      - in: path
        name: campaign_id
        schema:
          type: string
          format: uuid
        description: Campaign UUID
        required: true
      - in: path
        name: project_id
        schema:
          type: string
          format: uuid
        description: Project UUID
        required: true
      - in: query
        name: schedule_id
        schema:
          type: string
          format: uuid
        description: Preview under this CampaignSchedule's eligibility_workflow. Omit
          to preview with no eligibility rule (everyone in the pivot) — eligibility
          is per-schedule, not a campaign default.
      - in: query
        name: sync
        schema:
          type: boolean
        description: Re-sync the pivot first (default true).
      tags:
      - campaigns
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CampaignPreview'
          description: ''
  /api/campaigns/{project_id}/{campaign_id}/sync/:
    post:
      operationId: campaigns_sync_create
      description: Run contact_source → pivot sync (persists the pivot; no dialing).
      parameters:
      - in: path
        name: campaign_id
        schema:
          type: string
          format: uuid
        description: Campaign UUID
        required: true
      - in: path
        name: project_id
        schema:
          type: string
          format: uuid
        description: Project UUID
        required: true
      tags:
      - campaigns
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CampaignSyncResult'
          description: ''
  /api/communication/v1/channels/{channel_id}/messages/:
    post:
      operationId: communication_v1_channels_messages_create
      description: |-
        Proactive send via a channel directly — resolves or creates the
        conversation for the given recipient (e.g. a voice agent notifying a
        customer without a prior inbound message).
      parameters:
      - in: path
        name: channel_id
        schema:
          type: string
          format: uuid
        description: Channel UUID
        required: true
      tags:
      - communication
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ChannelOutboundMessage'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ChannelOutboundMessage'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ChannelOutboundMessage'
        required: true
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OutboundMessageResult'
          description: ''
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OutboundMessageResult'
          description: ''
  /api/communication/v1/conversations/{conversation_id}/messages/:
    post:
      operationId: communication_v1_conversations_messages_create
      description: |-
        Reply within an existing conversation — the channel and recipient are
        implied by the conversation, the same way an AI agent replies.
      parameters:
      - in: path
        name: conversation_id
        schema:
          type: string
          format: uuid
        description: Conversation UUID
        required: true
      tags:
      - communication
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ConversationOutboundMessage'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ConversationOutboundMessage'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ConversationOutboundMessage'
        required: true
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OutboundMessageResult'
          description: ''
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OutboundMessageResult'
          description: ''
  /api/organizations/:
    get:
      operationId: organizations_list
      description: |-
        Organization endpoints for authenticated users.
        Users can list and view their organization(s).
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
