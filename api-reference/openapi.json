    Payment:
      type: object
      description: |-
        Public checkout payload. Both views using it are AllowAny with no auth.

        gateway_response/gateway_events are deliberately absent: they carry the raw
        PayTR payload (hash, merchant_oid, webhook history) and merchant-side error
        text. Failures surface through failure_code/failure_message instead. metadata
        is projected through explicit nested serializers so a new internal key added
        to it never leaks.
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        organization_name:
          type: string
          readOnly: true
        gateway:
          $ref: '#/components/schemas/GatewayEnum'
        amount_cents:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        currency:
          type: string
          maxLength: 10
        kind:
          $ref: '#/components/schemas/KindEnum'
        status:
          $ref: '#/components/schemas/StatusEnum'
        items:
          description: "\n        Each item:\n        - name: str\n        - kind:
            one-time | recurring\n        - quantity: int\n        - unit_price_cents:
            int (USD source or display currency)\n        - amount_cents: int (unit_price_cents
            * quantity)\n        - currency: str (display only)\n        "
        pricing:
          allOf:
          - $ref: '#/components/schemas/PaymentPricing'
          nullable: true
          readOnly: true
        fx:
          allOf:
          - $ref: '#/components/schemas/PaymentFx'
          nullable: true
          readOnly: true
        failure_code:
          type: string
          nullable: true
          readOnly: true
        failure_message:
          type: string
          nullable: true
          readOnly: true
        expires_at:
          type: string
          format: date-time
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        is_expired:
          type: boolean
          readOnly: true
      required:
      - created_at
      - failure_code
      - failure_message
      - fx
      - id
      - is_expired
      - organization_name
      - pricing
    PaymentFx:
      type: object
      properties:
        from:
          type: string
        to:
          type: string
        rate:
          type: number
          format: double
        subtotal:
          type: integer
        rate_date:
          type: string
          nullable: true
        rate_source:
          type: string
          nullable: true
        rate_quote:
          type: string
          nullable: true
        rate_updated_at:
          type: string
          nullable: true
    PaymentMethod:
      type: object
      description: |-
        A stored card as the checkout page may show it.

        gateway_token (PayTR ctoken) is deliberately absent: the card endpoints are
        AllowAny, so the client names a card by its PaymentMethod id and the token is
        resolved server-side. The cardholder name in metadata is left out for the
        same reason — last 4 + brand + bank identify the card without adding PII to
        a payload anyone holding the link can read.
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        card_brand:
          type: string
          maxLength: 50
        card_last_4:
          type: string
          maxLength: 4
        bank:
          type: string
          readOnly: true
        exp_month:
          type: string
          readOnly: true
        exp_year:
          type: string
          readOnly: true
        require_cvv:
          type: boolean
          readOnly: true
      required:
      - bank
      - exp_month
      - exp_year
      - id
      - require_cvv
    PaymentMethodList:
      type: object
      description: 'The card picker''s payload: the cards, and which one the invoice
        is on.'
      properties:
        selected_id:
          type: string
          format: uuid
          nullable: true
        methods:
          type: array
          items:
            $ref: '#/components/schemas/PaymentMethod'
      required:
      - methods
      - selected_id
    PaymentPricing:
      type: object
      description: |-
        The pricing breakdown a checkout page renders. See Payment.metadata help_text.

        Every field is optional: metadata is written by management commands with no
        schema, and older rows predate some keys.
      properties:
        base_type:
          type: string
        discount_type:
          type: string
        discount_cents:
          type: integer
        discount_percentage:
          type: integer
        tax_rate:
          type: integer
        net_amount_cents:
          type: integer
        tax_amount_cents:
          type: integer
        final_amount:
          type: integer
    Project:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        organization_id:
          type: string
          readOnly: true
        organization_name:
          type: string
          readOnly: true
        name:
          type: string
          maxLength: 255
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - name
      - organization_id
      - organization_name
      - updated_at
    RefreshTokenRequest:
      type: object
      properties:
        refresh_token:
          type: string
      required:
      - refresh_token
    RefreshTokenResponse:
      type: object
      properties:
        access_token:
          type: string
      required:
      - access_token
    SavedCardToken:
      type: object
      description: |-
        Request body for paying an invoice with an already-stored card.

        Only the card is named. CVV, when the card requires one, is typed into the
        form the browser posts to PayTR and never passes through us.
      properties:
        payment_method_id:
          type: string
          format: uuid
      required:
      - payment_method_id
    StateFf0Enum:
      enum:
      - queued
      - ringing
      - in_progress
      - ended
      - failed
      - cancelled
      type: string
      description: |-
        * `queued` - Queued
        * `ringing` - Ringing
        * `in_progress` - In Progress
        * `ended` - Ended
        * `failed` - Failed
        * `cancelled` - Cancelled
    StatusEnum:
      enum:
      - pending
      - success
      - failed
      - expired
      - cancelled
      type: string
      description: |-
        * `pending` - Pending
        * `success` - Success
        * `failed` - Failed
        * `expired` - Expired
        * `cancelled` - Cancelled
    Transcript:
      type: object
      properties:
        _id:
          type: string
          title: ' id'
        projectID:
          type: string
        conversationID:
          type: string
        sessionID:
          type: string
        reportTags:
          type: array
          items:
            type: string
        unread:
          type: boolean
          readOnly: true
        starred:
          type: boolean
          readOnly: true
        labels:
          type: array
          items:
            type: string
        platform:
          type: string
        browser:
          type: string
        device:
          type: string
        os:
          type: string
        user:
          allOf:
          - $ref: '#/components/schemas/TranscriptUser'
          readOnly: true
        createdAt:
          type: string
          format: date-time
        updatedAt:
          type: string
          format: date-time
      required:
      - _id
      - browser
      - conversationID
      - createdAt
      - device
      - labels
      - os
      - platform
      - projectID
      - reportTags
      - sessionID
      - starred
      - unread
      - updatedAt
      - user
    TranscriptUser:
      type: object
      properties:
        name:
          type: string
        image:
          type: string
      required:
      - image
      - name
    TypeDffEnum:
      enum:
      - text
      - image
      - document
      - template
      type: string
      description: |-
        * `text` - text
        * `image` - image
        * `document` - document
        * `template` - template
    VersionIDEnum:
      enum:
      - production
      - development
      type: string
      description: |-
        * `production` - production
        * `development` - development
  securitySchemes:
    jwtAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
    tokenAuth:
      type: http
      scheme: bearer
servers:
- url: https://platform-api.sophy.co
  description: API Server
