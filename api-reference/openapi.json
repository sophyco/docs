      description: |-
        Start a confirmed batch of record ids as one manual run.

        Ids are looked up again; only callable ones are dialed. ``confirm_count``
        must equal that number — if the source changed since the user reviewed
        the list, the fresh results come back with 409 ``count_changed``.
      parameters:
      - in: header
        name: Sophy-Project
        required: true
        schema:
          type: string
          format: uuid
        description: Project the request acts on. API keys bound to a project may
          omit it; when sent, it must match the key's project.
      - in: header
        name: Idempotency-Key
        schema:
          type: string
        description: 'Repeat-safe start: the same key within 10 minutes returns the
          first result instead of dialing again.'
      - in: path
        name: campaign_id
        schema:
          type: string
          format: uuid
        description: Campaign UUID
        required: true
      tags:
      - v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/OutreachStartRun'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/OutreachStartRun'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/OutreachStartRun'
        required: true
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OutreachStartedRun'
          description: ''
