openapi: 3.0.3
info:
  title: Sophy Communication Platform API
  version: 1.0.0
  description: REST API for authentication, token management, and transcript/dialogue
    retrieval
paths:
  /api/analytics/{project_id}/:
    post:
      operationId: analytics_batch
      description: |-
        Run a batch of independent aggregation queries against a project's
        calls / conversations / campaigns in one request. Structural and
        semantic errors are validated for the WHOLE batch up front (a single
        400 listing every accepted-values set); once that passes, each query
        runs independently — one query's runtime failure becomes an `error`
        field in its own result slot, not a failed batch.
      parameters:
      - in: path
        name: project_id
        required: true
        schema:
          type: string
          format: uuid
        description: Project UUID
      tags:
      - analytics
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AnalyticsRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AnalyticsRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AnalyticsRequest'
        required: true
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AnalyticsResponse'
          description: ''
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AnalyticsValidationError'
          description: ''
      deprecated: true
  /api/auth/invitations/{token}/:
    get:
      operationId: auth_invitations_retrieve
      parameters:
      - in: path
        name: token
        schema:
          type: string
        required: true
      tags:
      - auth
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Invitation'
          description: ''
      deprecated: true
  /api/auth/invitations/accept/:
    post:
      operationId: auth_invitations_accept_create
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/InvitationAccept'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/InvitationAccept'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/InvitationAccept'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Session'
          description: ''
      deprecated: true
  /api/auth/login/:
    post:
      operationId: auth_login_create
      description: Email + password login. Returns an access token; the refresh token
        is set as an httpOnly cookie (`sophy_refresh`, path `/api/v1/auth/`). Send
        requests with credentials.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Login'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Login'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Login'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Session'
          description: ''
      deprecated: true
  /api/auth/logout/:
    post:
      operationId: auth_logout_create
      description: End this browser session (works with an expired access token).
      parameters:
      - in: header
        name: X-Sophy-CSRF
        schema:
          type: string
          enum:
          - '1'
        description: CSRF guard for cookie-authenticated endpoints. Always `1`.
        required: true
      tags:
      - auth
      security:
      - {}
      responses:
        '204':
          description: No response body
      deprecated: true
  /api/auth/me/:
    get:
      operationId: auth_me_retrieve
      tags:
      - auth
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
          description: ''
      deprecated: true
    patch:
      operationId: auth_me_partial_update
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedUser'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedUser'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedUser'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
          description: ''
      deprecated: true
  /api/auth/password/change/:
    post:
      operationId: auth_password_change_create
      description: Change the password. Every other session is logged out; this one
        gets a new token pair.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PasswordChange'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PasswordChange'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PasswordChange'
        required: true
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Session'
          description: ''
      deprecated: true
  /api/auth/password/reset/:
    post:
      operationId: auth_password_reset_create
      description: Email a reset link if an active account exists. Always 204 (no
        account enumeration).
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PasswordResetRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PasswordResetRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PasswordResetRequest'
        required: true
      security:
      - {}
      responses:
        '204':
          description: No response body
      deprecated: true
  /api/auth/password/reset/confirm/:
    post:
      operationId: auth_password_reset_confirm_create
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PasswordResetConfirm'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PasswordResetConfirm'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PasswordResetConfirm'
        required: true
      security:
      - {}
      responses:
        '204':
          description: No response body
      deprecated: true
  /api/auth/permissions/:
    get:
      operationId: auth_permissions_retrieve
      description: Every permission and what each role grants — for building role
        pickers and scope lists.
      tags:
      - auth
      security:
      - jwtAuth: []
      - tokenAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PermissionCatalog'
          description: ''
      deprecated: true
  /api/auth/token/refresh/:
    post:
      operationId: auth_token_refresh_create
      description: Rotate the refresh cookie and return a new access token. 401 =
        the session is over.
      parameters:
      - in: header
        name: X-Sophy-CSRF
        schema:
          type: string
          enum:
          - '1'
        description: CSRF guard for cookie-authenticated endpoints. Always `1`.
        required: true
      tags:
      - auth
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Session'
          description: ''
      deprecated: true
  /api/auth/tokens/:
    get:
      operationId: auth_tokens_list
      description: |-
        The caller's own API keys. The secret is returned once, by create;
        DELETE revokes the key (it stops working immediately) and keeps the row
        for audit.
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      tags:
      - auth
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAPITokenList'
          description: ''
      deprecated: true
    post:
      operationId: auth_tokens_create
      description: |-
        The caller's own API keys. The secret is returned once, by create;
        DELETE revokes the key (it stops working immediately) and keeps the row
        for audit.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/APIToken'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/APIToken'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/APIToken'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/APITokenCreated'
          description: ''
      deprecated: true
  /api/auth/tokens/{id}/:
    get:
      operationId: auth_tokens_retrieve
      description: |-
        The caller's own API keys. The secret is returned once, by create;
        DELETE revokes the key (it stops working immediately) and keeps the row
        for audit.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this api token.
        required: true
      tags:
      - auth
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/APIToken'
          description: ''
      deprecated: true
    patch:
      operationId: auth_tokens_partial_update
      description: |-
        The caller's own API keys. The secret is returned once, by create;
        DELETE revokes the key (it stops working immediately) and keeps the row
        for audit.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this api token.
        required: true
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedUserAPITokenUpdate'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedUserAPITokenUpdate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedUserAPITokenUpdate'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserAPITokenUpdate'
          description: ''
      deprecated: true
    delete:
      operationId: auth_tokens_destroy
      description: |-
        The caller's own API keys. The secret is returned once, by create;
        DELETE revokes the key (it stops working immediately) and keeps the row
        for audit.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this api token.
        required: true
      tags:
      - auth
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
      deprecated: true
  /api/calls/{project_id}/:
    get:
      operationId: calls_list
      description: List calls in a project, newest first.
      parameters:
      - in: path
        name: project_id
        required: true
        schema:
          type: string
          format: uuid
        description: Project UUID
      - in: query
        name: agent_id
        schema:
          type: integer
        description: AI agent's numeric id.
      - in: query
        name: agent_name
        schema:
          type: string
        description: Agent name, case-insensitive substring. Use this when the UI
          has a name rather than an id.
      - in: query
        name: campaign_id
        schema:
          type: string
          format: uuid
      - in: query
        name: campaign_name
        schema:
          type: string
        description: Campaign name, case-insensitive substring.
      - in: query
        name: channel_id
        schema:
          type: string
          format: uuid
      - in: query
        name: channel_name
        schema:
          type: string
        description: Channel name, case-insensitive substring.
      - in: query
        name: contact_id
        schema:
          type: string
          format: uuid
      - in: query
        name: date_from
        schema:
          type: string
          format: date-time
        description: 'Inclusive lower bound on created_at — when the call was recorded.
          Not started_at: a call that never connected has none, and would drop out
          of the range entirely.'
      - in: query
        name: date_to
        schema:
          type: string
          format: date-time
        description: Inclusive upper bound on created_at.
      - in: query
        name: direction
        schema:
          type: string
        description: inbound | outbound
      - in: query
        name: external_ref
        schema:
          type: string
        description: Customer record id a Studio-started call was placed for.
      - in: query
        name: has_recording
        schema:
          type: boolean
      - in: query
        name: initiated_by
        schema:
          type: integer
        description: User who confirmed and started the call in Studio.
      - in: query
        name: limit
        schema:
          type: integer
        description: Max results to return (default 100, max 1000)
      - in: query
        name: number
        schema:
          type: string
        description: Substring match on either number
      - in: query
        name: offset
        schema:
          type: integer
        description: Number of items to skip (default 0)
      - in: query
        name: origin
        schema:
          type: string
        description: inbound | campaign | manual | api
      - in: query
        name: outcome
        schema:
          type: string
      - in: query
        name: platform_type
        schema:
          type: string
      - in: query
        name: run_id
        schema:
          type: string
          format: uuid
      - in: query
        name: state
        schema:
          type: string
      tags:
      - calls
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedCallList'
          description: ''
      deprecated: true
  /api/calls/{project_id}/{call_id}/:
    get:
      operationId: calls_retrieve
      description: Retrieve one call, with its stored report.
      parameters:
      - in: path
        name: project_id
        required: true
        schema:
          type: string
          format: uuid
        description: Project UUID
      - in: path
        name: call_id
        schema:
          type: string
          format: uuid
        description: Call UUID
        required: true
      tags:
      - calls
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CallDetail'
          description: ''
      deprecated: true
  /api/calls/{project_id}/{call_id}/messages/:
    get:
      operationId: calls_messages
      description: The turn-by-turn conversation for a call.
      parameters:
      - in: path
        name: project_id
        required: true
        schema:
          type: string
          format: uuid
        description: Project UUID
      - in: path
        name: call_id
        schema:
          type: string
          format: uuid
        description: Call UUID
        required: true
      - in: query
        name: limit
        schema:
          type: integer
      - in: query
        name: offset
        schema:
          type: integer
      tags:
      - calls
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedCallMessageList'
          description: ''
      deprecated: true
  /api/calls/{project_id}/{call_id}/replay/:
    post:
      operationId: calls_replay
      description: |-
        Re-run the post-call workflow for a call from its stored report.

        Side-effecting: this re-sends the report email. Nothing is recomputed from
        the provider — the stored report is replayed through the same entry point
        the webhook uses, so recording storage and email happen exactly as they did
        the first time.
      parameters:
      - in: path
        name: project_id
        required: true
        schema:
          type: string
          format: uuid
        description: Project UUID
      - in: path
        name: call_id
        schema:
          type: string
          format: uuid
        description: Call UUID
        required: true
      tags:
      - calls
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CallReplayRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CallReplayRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CallReplayRequest'
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '202':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CallReplayAccepted'
          description: ''
        '404':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CallReplayNoReport'
          description: ''
      deprecated: true
  /api/calls/{project_id}/numbers/{number}/:
    get:
      operationId: calls_number_history
      description: 'Everything that ever happened on one number: the rollup plus every
        attempt.'
      parameters:
      - in: path
        name: project_id
        required: true
        schema:
          type: string
          format: uuid
        description: Project UUID
      - in: query
        name: limit
        schema:
          type: integer
      - in: path
        name: number
        schema:
          type: string
        description: Phone number in E.164
        required: true
      - in: query
        name: offset
        schema:
          type: integer
      tags:
      - calls
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/NumberCallHistory'
          description: ''
      deprecated: true
  /api/calls/{project_id}/summary/:
    get:
      operationId: calls_summary
      description: Aggregate KPIs for a project's calls. Computed in the DB, not in
        Python.
      parameters:
      - in: path
        name: project_id
        required: true
        schema:
          type: string
          format: uuid
        description: Project UUID
      - in: query
        name: agent_name
        schema:
          type: string
      - in: query
        name: campaign_id
        schema:
          type: string
          format: uuid
      - in: query
        name: campaign_name
        schema:
          type: string
      - in: query
        name: channel_name
        schema:
          type: string
      - in: query
        name: date_from
        schema:
          type: string
          format: date-time
        description: 'Inclusive lower bound on created_at — when the call was recorded.
          Not started_at: a call that never connected has none, and would drop out
          of the range entirely.'
      - in: query
        name: date_to
        schema:
          type: string
          format: date-time
        description: Inclusive upper bound on created_at.
      - in: query
        name: direction
        schema:
          type: string
      - in: query
        name: group_by
        schema:
          type: string
        description: day | outcome | state | channel | campaign (omit for totals only)
      - in: query
        name: origin
        schema:
          type: string
      tags:
      - calls
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CallSummary'
          description: ''
      deprecated: true
  /api/campaigns/{project_id}/:
    get:
      operationId: campaigns_list
      description: List the project's campaigns (archived ones excluded unless ?archived=true).
      parameters:
      - in: path
        name: project_id
        required: true
        schema:
          type: string
          format: uuid
        description: Project UUID
      tags:
      - campaigns
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/OutreachCampaign'
          description: ''
      deprecated: true
  /api/campaigns/{project_id}/{campaign_id}/:
    get:
      operationId: campaigns_retrieve
      description: Retrieve a single campaign.
      parameters:
      - in: path
        name: project_id
        required: true
        schema:
          type: string
          format: uuid
        description: Project UUID
      - in: path
        name: campaign_id
        schema:
          type: string
          format: uuid
        description: Campaign UUID
        required: true
      tags:
      - campaigns
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OutreachCampaign'
          description: ''
      deprecated: true
  /api/campaigns/{project_id}/{campaign_id}/preview/:
    post:
      operationId: campaigns_preview_create
      description: 'Dry-run: who would be dialed, with which vars. Nothing is dispatched.'
      parameters:
      - in: path
        name: project_id
        required: true
        schema:
          type: string
          format: uuid
        description: Project UUID
      - in: path
        name: campaign_id
        schema:
          type: string
          format: uuid
        description: Campaign UUID
        required: true
      - in: query
        name: schedule_id
        schema:
          type: string
          format: uuid
        description: Preview under this CampaignSchedule's eligibility_workflow. Omit
          to preview with no eligibility rule (everyone in the pivot) — eligibility
          is per-schedule, not a campaign default.
      - in: query
        name: sync
        schema:
          type: boolean
        description: Re-sync the pivot first (default true).
      tags:
      - campaigns
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CampaignPreview'
          description: ''
      deprecated: true
  /api/campaigns/{project_id}/{campaign_id}/sync/:
    post:
      operationId: campaigns_sync_create
      description: Run contact_source → pivot sync (persists the pivot; no dialing).
      parameters:
      - in: path
        name: project_id
        required: true
        schema:
          type: string
          format: uuid
        description: Project UUID
      - in: path
        name: campaign_id
        schema:
          type: string
          format: uuid
        description: Campaign UUID
        required: true
      tags:
      - campaigns
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CampaignSyncResult'
          description: ''
      deprecated: true
  /api/communication/v1/channels/{channel_id}/messages/:
    post:
      operationId: communication_v1_channels_messages_create
      description: |-
        Proactive send via a channel directly — resolves or creates the
        conversation for the given recipient (e.g. a voice agent notifying a
        customer without a prior inbound message).
      parameters:
      - in: path
        name: channel_id
        schema:
          type: string
          format: uuid
        description: Channel UUID
        required: true
      tags:
      - communication
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ChannelOutboundMessage'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ChannelOutboundMessage'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ChannelOutboundMessage'
        required: true
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OutboundMessageResult'
          description: ''
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OutboundMessageResult'
          description: ''
        '422':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OutboundMessageResult'
          description: ''
  /api/communication/v1/conversations/{conversation_id}/messages/:
    post:
