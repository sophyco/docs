  /api/v1/analytics/:
    post:
      operationId: analytics_batch_2
      description: |-
        Run a batch of independent aggregation queries against a project's
        calls / conversations / campaigns in one request. Structural and
        semantic errors are validated for the WHOLE batch up front (a single
        400 listing every accepted-values set); once that passes, each query
        runs independently — one query's runtime failure becomes an `error`
        field in its own result slot, not a failed batch.
      parameters:
      - in: header
        name: Sophy-Project
        required: true
        schema:
          type: string
          format: uuid
        description: Project the request acts on. API keys bound to a project may
          omit it; when sent, it must match the key's project.
      tags:
      - v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AnalyticsRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AnalyticsRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AnalyticsRequest'
        required: true
      security:
      - tokenAuth: []
