  /api/workflows/recordings/{filename}/:
    get:
      operationId: workflows_recordings_retrieve
      description: |-
        Provider-independent, permanent recording link. The email link points here;
        on click we mint a fresh short-lived signed URL for the private S3 object
        (key reconstructed from the self-contained filename) and 302-redirect.

        Public by design — security is the unguessable filename (contains the VAPI
        call UUID). Used when a workflow's recording.link_from is the S3 destination.
      parameters:
      - in: path
        name: filename
        schema:
          type: string
        description: Self-contained recording filename ({call_id}_{ts}_{assistant_id}_{type}.wav)
        required: true
      tags:
      - workflows
      security:
      - {}
      responses:
        '302':
          description: No response body
        '404':
          description: No response body
components:
  schemas:
    APIToken:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        token:
          type: string
          readOnly: true
        type:
          $ref: '#/components/schemas/APITokenTypeEnum'
        name:
          type: string
          description: Token name/description
          maxLength: 255
        user_id:
          type: string
          readOnly: true
        is_active:
          type: boolean
        expires_at:
          type: string
          format: date-time
          nullable: true
          description: Token expiration date. Leave blank for unlimited.
        last_used_at:
          type: string
          format: date-time
          nullable: true
        is_expired:
          type: boolean
          readOnly: true
        is_valid:
          type: boolean
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - is_expired
      - is_valid
      - name
      - token
      - updated_at
      - user_id
    APITokenTypeEnum:
      enum:
      - user
      - service
      type: string
      description: |-
        * `user` - User Token
        * `service` - Service Account Token
    AccountTypeEnum:
      enum:
      - individual
      - business
      type: string
      description: |-
        * `individual` - Individual
        * `business` - Business
    BackendEnum:
      enum:
      - native
      - chatwoot
      type: string
      description: |-
        * `native` - native
        * `chatwoot` - chatwoot
    BillingProfile:
      type: object
      properties:
        account_type:
          $ref: '#/components/schemas/AccountTypeEnum'
        first_name:
          type: string
          maxLength: 150
        last_name:
          type: string
          maxLength: 150
        company_name:
          type: string
          maxLength: 255
        tax_id:
          type: string
          maxLength: 20
        phone:
          type: string
          maxLength: 30
        email:
          type: string
          format: email
          maxLength: 254
        address: {}
        po_number:
          type: string
          maxLength: 100
    BlankEnum:
      enum:
      - ''
    CallDetail:
      type: object
      description: 'A single call: ledger row plus its stored report.'
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        project_id:
          type: string
          format: uuid
          readOnly: true
        channel_id:
          type: string
          format: uuid
          readOnly: true
        channel_name:
          type: string
          readOnly: true
        platform_type:
          type: string
          description: Denormalized from channel for reporting.
          maxLength: 50
        direction:
          $ref: '#/components/schemas/DirectionEnum'
        origin:
          $ref: '#/components/schemas/OriginEnum'
        provider_call_id:
          type: string
          nullable: true
          description: Provider-side call id (VAPI call.id). Null until dispatched.
          maxLength: 255
        from_number:
          type: string
          maxLength: 64
        to_number:
          type: string
          maxLength: 64
        agent_id:
          type: integer
          nullable: true
          readOnly: true
        agent_name:
          type: string
          readOnly: true
        agent_ref:
          type: string
          nullable: true
          description: Raw provider assistant id — survives agent deletion.
          maxLength: 255
        run_id:
          type: string
          format: uuid
          nullable: true
          readOnly: true
        campaign_id:
          type: string
          format: uuid
          readOnly: true
        campaign_name:
          type: string
          readOnly: true
        contact_id:
          type: string
          format: uuid
          nullable: true
          readOnly: true
        run_attempt_no:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
        state:
          $ref: '#/components/schemas/StateFf0Enum'
        outcome:
          nullable: true
          oneOf:
          - $ref: '#/components/schemas/OutcomeEnum'
          - $ref: '#/components/schemas/BlankEnum'
          - $ref: '#/components/schemas/NullEnum'
        end_reason_raw:
          type: string
          nullable: true
          description: Provider's raw endedReason, stored verbatim.
          maxLength: 255
        started_at:
          type: string
          format: date-time
          nullable: true
        ended_at:
          type: string
          format: date-time
          nullable: true
        duration_sec:
          type: number
          format: double
          nullable: true
        cost:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,4})?$
          nullable: true
        recording_url:
          type: string
          format: uri
          nullable: true
          maxLength: 2048
        has_recording:
          type: boolean
          readOnly: true
        has_report:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        structured_output: {}
        vars_snapshot: {}
        report:
          allOf:
          - $ref: '#/components/schemas/CallReport'
          nullable: true
          readOnly: true
      required:
      - agent_id
      - agent_name
      - campaign_id
      - campaign_name
      - channel_id
      - channel_name
      - contact_id
      - created_at
      - direction
      - has_recording
      - id
      - origin
      - project_id
      - report
      - run_id
      - structured_output
      - updated_at
      - vars_snapshot
