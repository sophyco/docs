    EmbedChatwoot:
      type: object
      description: Present only when the widget runs against Chatwoot instead of the
        native runtime.
      properties:
        baseURL:
          type: string
          description: Browser-facing ChatDash origin, without the /api suffix.
        inboxIdentifier:
          type: string
          description: Chatwoot public inbox identifier (not the numeric inbox id).
      required:
      - baseURL
      - inboxIdentifier
    EmbedConfig:
      type: object
      description: |-
        Everything the embed service needs to render one widget's script.

        Mirrors the argument the widget bundle expects at
        ``window.sophy.chat.load()``, plus the few fields the service needs to build
        the script around it. Branding is NOT included: the bundle fetches that from
        the publishing endpoint itself, and duplicating it would create a second
        source of truth for the same fields.
      properties:
        tenant:
          type: string
          description: Organization slug; first segment of the embed URL.
        widget:
          type: string
          description: Webchat slug; second segment of the embed URL.
        bundle:
          type: string
          description: Widget runtime bundle the script injects.
        backend:
          allOf:
          - $ref: '#/components/schemas/BackendEnum'
          description: |-
            Derived from the widget's Channel, not stored on the widget.

            * `native` - native
            * `chatwoot` - chatwoot
        verify:
          $ref: '#/components/schemas/EmbedVerify'
        url:
          type: string
          description: Runtime base URL the widget posts to.
        versionID:
          allOf:
          - $ref: '#/components/schemas/VersionIDEnum'
          description: |-
            Published version of the agent the widget talks to.

            * `production` - production
            * `development` - development
        identity:
          type: object
          additionalProperties: {}
          description: 'How the visitor is resolved on the host page, e.g. {''adapter'':
            ''ticimax''}. Known adapters: none, ticimax, localstorage.'
        proactive:
          type: array
          items:
            $ref: '#/components/schemas/EmbedProactive'
        assistant:
          type: object
          additionalProperties: {}
          description: 'Loader-level assistant overrides: inputLauncher, and position/launcherPosition/chatPosition
            from [''left'', ''right'', ''center''].'
        user:
          type: object
          additionalProperties: {}
          description: 'Guest fallback, e.g. {''name'': ''Guest User''}.'
        render:
          type: object
          additionalProperties: {}
          description: 'Mount target, e.g. {''mode'': ''overlay''}. Modes: [''overlay'',
            ''embedded'', ''sidebar''].'
        analytics:
          description: true, false, or 'dataLayer'. Absent → the bundle's default
            (true).
        language:
          allOf:
          - $ref: '#/components/schemas/LanguageEnum'
          description: |-
            Widget UI language.

            * `en` - en
            * `tr` - tr
            * `de` - de
        allowDangerousHTML:
          type: boolean
          description: Render raw HTML in assistant messages.
        chatwoot:
          allOf:
          - $ref: '#/components/schemas/EmbedChatwoot'
          description: Present only when backend is 'chatwoot'.
        launch:
          type: object
          additionalProperties: {}
          description: 'Launch event for the native runtime, e.g. {''event'': {''type'':
            ''launch'', ''payload'': {...}}}. Absent when backend is ''chatwoot'',
            which has no equivalent.'
      required:
      - assistant
      - backend
      - bundle
      - identity
      - proactive
      - render
      - tenant
      - url
      - user
      - verify
      - versionID
      - widget
    EmbedProactive:
      type: object
