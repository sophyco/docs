    PatchedUser:
      type: object
      description: |-
        Canonical user payload returned by login and /auth/me/.

        ``is_superuser`` / ``is_staff`` / ``is_account_manager`` are platform-level flags (unrelated to the
        org-scoped membership roles) and are read-only — they can only be granted
        from Django admin, never through the API. They are also dropped from the
        payload when false, so they only ship to the handful of accounts that hold
        them. Consumers must treat an absent flag as false (fail closed).

        ``role`` is the deprecated global role; use ``memberships[].role``.
      properties:
        id:
          type: string
          readOnly: true
        username:
          type: string
          readOnly: true
          description: Required. 150 characters or fewer. Letters, digits and @/./+/-/_
            only.
        email:
          type: string
          format: email
          readOnly: true
          title: Email address
        first_name:
          type: string
          maxLength: 150
        last_name:
          type: string
          maxLength: 150
        is_active:
          type: boolean
          readOnly: true
          title: Active
          description: Designates whether this user should be treated as active. Unselect
            this instead of deleting accounts.
        role:
          allOf:
          - $ref: '#/components/schemas/UserRoleEnum'
          readOnly: true
        organization_ids:
          type: array
          items:
            type: string
          readOnly: true
        memberships:
          type: array
          items:
            $ref: '#/components/schemas/UserMembership'
          readOnly: true
        is_superuser:
          type: boolean
          readOnly: true
          title: Superuser status
          description: Designates that this user has all permissions without explicitly
            assigning them.
        is_staff:
          type: boolean
          readOnly: true
          title: Staff status
          description: Designates whether the user can log into this admin site.
        is_account_manager:
          type: boolean
          readOnly: true
          description: 'Sophy employee without Django admin access: hidden from customers,
            full access in the organizations and projects they are assigned to.'
    PatchedUserAPITokenUpdate:
      type: object
      description: Binding is fixed at creation; only the label, scopes and expiry
        change.
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          description: Token name/description
          maxLength: 255
        type:
          allOf:
          - $ref: '#/components/schemas/Type1c2Enum'
          readOnly: true
        prefix:
          type: string
          readOnly: true
          description: First characters of the secret, shown so a key can be recognised.
        user_id:
          type: string
          readOnly: true
          nullable: true
        service_account_id:
          type: string
          readOnly: true
          nullable: true
        organization:
          type: string
          format: uuid
          nullable: true
          description: Limit the key to one organization. Implied by `project`.
        project:
          type: string
          format: uuid
          nullable: true
          description: Bind the key to one project (recommended). Requests with a
            bound key need no Sophy-Project header.
        scopes:
          type: array
          items:
            $ref: '#/components/schemas/PermissionEnum'
          description: Limit the key to these permissions. Empty = the owner's permissions.
            A key never exceeds its owner, whatever its scopes say.
        is_active:
          type: boolean
          readOnly: true
        revoked_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        expires_at:
          type: string
          format: date-time
          nullable: true
          description: Token expiration date. Leave blank for unlimited.
        last_used_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        is_expired:
          type: boolean
          readOnly: true
        is_valid:
          type: boolean
          readOnly: true
        is_legacy:
          type: boolean
          readOnly: true
          description: Issued by the old key system; deprecated, to be replaced with
            a new key.
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
