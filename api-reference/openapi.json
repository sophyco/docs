openapi: 3.0.3
info:
  title: Sophy Communication Platform API
  version: 1.0.0
  description: REST API for authentication, token management, and transcript/dialogue
    retrieval
paths:
  /api/auth/login/:
    post:
      operationId: auth_login_create
      description: User login endpoint. Returns JWT access + refresh tokens.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Login'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Login'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Login'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Login'
          description: ''
  /api/auth/logout/:
    post:
      operationId: auth_logout_create
      description: Blacklists the refresh token, invalidating the session.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LogoutRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LogoutRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LogoutRequest'
        required: true
      security:
      - jwtAuth: []
      - tokenAuth: []
      responses:
        '204':
          description: No response body
  /api/auth/token/refresh/:
    post:
      operationId: auth_token_refresh_create
      description: Returns a new access token given a valid refresh token.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RefreshTokenRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/RefreshTokenRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/RefreshTokenRequest'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RefreshTokenResponse'
          description: ''
  /api/auth/tokens/:
    get:
      operationId: auth_tokens_list
      description: |-
        API Token management for authenticated users.
        Users can create, list, update, and delete their own tokens.
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - auth
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAPITokenList'
          description: ''
    post:
      operationId: auth_tokens_create
      description: |-
        API Token management for authenticated users.
        Users can create, list, update, and delete their own tokens.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/APIToken'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/APIToken'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/APIToken'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/APIToken'
          description: ''
  /api/auth/tokens/{id}/:
    get:
      operationId: auth_tokens_retrieve
      description: |-
        API Token management for authenticated users.
        Users can create, list, update, and delete their own tokens.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this api token.
        required: true
      tags:
      - auth
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/APIToken'
          description: ''
    patch:
      operationId: auth_tokens_partial_update
      description: |-
        API Token management for authenticated users.
        Users can create, list, update, and delete their own tokens.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this api token.
        required: true
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedAPIToken'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedAPIToken'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedAPIToken'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/APIToken'
          description: ''
    delete:
      operationId: auth_tokens_destroy
      description: |-
        API Token management for authenticated users.
        Users can create, list, update, and delete their own tokens.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this api token.
        required: true
      tags:
      - auth
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/billing/callback/{gateway}/:
    post:
      operationId: billing_callback_create
      parameters:
      - in: path
        name: gateway
        schema:
          type: string
        description: Payment gateway name (e.g. paytr)
        required: true
      tags:
      - Billing
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GatewayCallback'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/GatewayCallback'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/GatewayCallback'
        required: true
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
                description: Unspecified response body
          description: ''
  /api/billing/payments/{id}/:
    get:
      operationId: billing_payments_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: Payment ID (UUID)
        required: true
      tags:
      - Billing
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'
          description: ''
  /api/billing/payments/{id}/profile/:
    get:
      operationId: billing_payments_profile_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Billing
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BillingProfile'
          description: ''
    post:
      operationId: billing_payments_profile_create
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Billing
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/BillingProfile'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/BillingProfile'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/BillingProfile'
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BillingProfile'
          description: ''
  /api/billing/payments/{id}/token/{gateway}/:
    post:
      operationId: billing_payments_token_create
      parameters:
      - in: path
        name: gateway
        schema:
          type: string
        required: true
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Billing
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
                description: Unspecified response body
          description: ''
  /api/billing/payments/{session_id}/session/:
    get:
      operationId: billing_payments_session_retrieve
      parameters:
      - in: path
        name: session_id
        schema:
          type: string
        description: Payment session ID (e.g. SPUU4V61XFW3)
        required: true
      tags:
      - Billing
      security:
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'
          description: ''
  /api/organizations/:
    get:
      operationId: organizations_list
      description: |-
        Organization endpoints for authenticated users.
        Users can list and view their organization(s).
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - organizations
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedOrganizationList'
          description: ''
  /api/organizations/{id}/:
    get:
      operationId: organizations_retrieve
      description: |-
        Organization endpoints for authenticated users.
        Users can list and view their organization(s).
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: Organization UUID
        required: true
      tags:
      - organizations
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Organization'
          description: ''
  /api/organizations/{organization_id}/projects/:
    get:
      operationId: organizations_projects_list
      description: |-
        Project endpoints for managing projects within an organization.
        Users can create, list, update, and delete projects in their organization.
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - in: path
        name: organization_id
        schema:
          type: string
          format: uuid
        description: Organization UUID
        required: true
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      tags:
      - organizations
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedProjectList'
          description: ''
    post:
      operationId: organizations_projects_create
      description: |-
        Project endpoints for managing projects within an organization.
        Users can create, list, update, and delete projects in their organization.
      parameters:
      - in: path
        name: organization_id
        schema:
          type: string
          format: uuid
        description: Organization UUID
        required: true
      tags:
      - organizations
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Project'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Project'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Project'
        required: true
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Project'
          description: ''
  /api/organizations/{organization_id}/projects/{id}/:
    get:
      operationId: organizations_projects_retrieve
      description: |-
        Project endpoints for managing projects within an organization.
        Users can create, list, update, and delete projects in their organization.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: Project UUID
        required: true
      - in: path
        name: organization_id
        schema:
          type: string
          format: uuid
        description: Organization UUID
        required: true
      tags:
      - organizations
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Project'
          description: ''
    patch:
      operationId: organizations_projects_partial_update
      description: |-
        Project endpoints for managing projects within an organization.
        Users can create, list, update, and delete projects in their organization.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: Project UUID
        required: true
      - in: path
        name: organization_id
        schema:
          type: string
          format: uuid
        description: Organization UUID
        required: true
      tags:
      - organizations
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedProject'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedProject'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedProject'
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Project'
          description: ''
    delete:
      operationId: organizations_projects_destroy
      description: |-
        Project endpoints for managing projects within an organization.
        Users can create, list, update, and delete projects in their organization.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: Project UUID
        required: true
      - in: path
        name: organization_id
        schema:
          type: string
          format: uuid
        description: Organization UUID
        required: true
      tags:
      - organizations
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/schema/:
    get:
      operationId: schema_retrieve
      description: |-
        OpenApi3 schema for this API. Format can be selected via content negotiation.

        - YAML: application/vnd.oai.openapi
        - JSON: application/vnd.oai.openapi+json
      parameters:
      - in: query
        name: format
        schema:
          type: string
          enum:
          - json
          - yaml
      - in: query
        name: lang
        schema:
          type: string
          enum:
          - af
          - ar
          - ar-dz
          - ast
          - az
          - be
          - bg
          - bn
          - br
          - bs
          - ca
          - ckb
          - cs
          - cy
          - da
          - de
          - dsb
          - el
          - en
          - en-au
          - en-gb
          - eo
          - es
          - es-ar
          - es-co
          - es-mx
          - es-ni
          - es-ve
          - et
          - eu
          - fa
          - fi
          - fr
          - fy
          - ga
          - gd
          - gl
          - he
          - hi
          - hr
          - hsb
          - ht
          - hu
          - hy
          - ia
          - id
          - ig
          - io
          - is
          - it
          - ja
          - ka
          - kab
          - kk
          - km
          - kn
          - ko
          - ky
          - lb
          - lt
          - lv
          - mk
          - ml
          - mn
          - mr
          - ms
          - my
          - nb
          - ne
          - nl
          - nn
          - os
          - pa
          - pl
          - pt
          - pt-br
          - ro
          - ru
          - sk
          - sl
          - sq
          - sr
          - sr-latn
          - sv
          - sw
          - ta
          - te
          - tg
          - th
          - tk
          - tr
          - tt
          - udm
          - ug
          - uk
          - ur
          - uz
          - vi
          - zh-hans
          - zh-hant
      tags:
      - schema
      security:
      - jwtAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          content:
            application/vnd.oai.openapi:
              schema:
                type: object
                additionalProperties: {}
            application/yaml:
              schema:
                type: object
                additionalProperties: {}
            application/vnd.oai.openapi+json:
              schema:
                type: object
                additionalProperties: {}
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/transcripts/{project_id}/:
    get:
      operationId: transcripts_list
      description: List transcripts for a project
      parameters:
      - in: query
        name: conversationID
        schema:
          type: string
      - in: query
        name: label
        schema:
          type: string
        description: Filter by label
      - in: query
        name: limit
        schema:
          type: integer
        description: Max results to return (default 100, max 1000)
      - in: query
        name: offset
        schema:
          type: integer
        description: Number of items to skip (default 0)
      - in: query
        name: platform
        schema:
          type: string
      - in: path
        name: project_id
        schema:
          type: string
          format: uuid
        description: Project ID
        required: true
      - in: query
        name: sessionID
        schema:
          type: string
      - in: query
        name: starred
        schema:
          type: boolean
        description: Filter by starred status for current user
      - in: query
        name: unread
        schema:
          type: boolean
      tags:
      - transcripts
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/PaginatedTranscriptList'
          description: ''
  /api/transcripts/{project_id}/{transcript_id}/labels/:
    patch:
      operationId: transcripts_labels_partial_update
      description: Replace labels on a transcript
      parameters:
      - in: path
        name: project_id
        schema:
          type: string
          format: uuid
        description: Project ID
        required: true
      - in: path
        name: transcript_id
        schema:
          type: string
        description: Transcript ID
        required: true
      tags:
      - transcripts
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedSetLabelsRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedSetLabelsRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedSetLabelsRequest'
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Transcript'
          description: ''
  /api/transcripts/{project_id}/{transcript_id}/read/:
    patch:
      operationId: transcripts_read_partial_update
      description: Mark a transcript as read for the current user
      parameters:
      - in: path
        name: project_id
        schema:
          type: string
          format: uuid
        description: Project ID
        required: true
      - in: path
        name: transcript_id
        schema:
          type: string
        description: Transcript ID
        required: true
      tags:
      - transcripts
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedTranscript'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedTranscript'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedTranscript'
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Transcript'
          description: ''
  /api/transcripts/{project_id}/{transcript_id}/star/:
    patch:
      operationId: transcripts_star_partial_update
      description: Toggle star for the current user on a transcript
      parameters:
      - in: path
        name: project_id
        schema:
          type: string
          format: uuid
        description: Project ID
        required: true
      - in: path
        name: transcript_id
        schema:
          type: string
        description: Transcript ID
        required: true
      tags:
      - transcripts
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedTranscript'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedTranscript'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedTranscript'
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Transcript'
          description: ''
  /api/transcripts/{project_id}/dialogues/:
    get:
      operationId: transcripts_dialogues_list
      description: List dialogues for a conversation
      parameters:
      - in: query
        name: conversationID
        schema:
          type: string
        description: Conversation ID
        required: true
      - in: query
        name: format
        schema:
          type: string
      - in: query
        name: limit
        schema:
          type: integer
        description: Max results to return (default 100, max 1000)
      - in: query
        name: offset
        schema:
          type: integer
        description: Number of items to skip (default 0)
      - in: path
        name: project_id
        schema:
          type: string
          format: uuid
        description: Project ID
        required: true
      - in: query
        name: role
        schema:
          type: string
      - in: query
        name: sessionID
        schema:
          type: string
      - in: query
        name: status
        schema:
          type: string
      - in: query
        name: type
        schema:
          type: string
      tags:
      - transcripts
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/PaginatedDialogueList'
          description: ''
  /api/transcripts/{project_id}/labels/:
    get:
      operationId: transcripts_labels_retrieve
      description: List all unique labels used in a project (for autocomplete)
      parameters:
      - in: path
        name: project_id
        schema:
          type: string
          format: uuid
        description: Project ID
        required: true
      tags:
      - transcripts
      security:
      - tokenAuth: []
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LabelList'
          description: ''
  /api/workflows/recordings/{filename}/:
    get:
      operationId: workflows_recordings_retrieve
      description: |-
        Provider-independent, permanent recording link. The email link points here;
        on click we mint a fresh short-lived signed URL for the private S3 object
        (key reconstructed from the self-contained filename) and 302-redirect.

        Public by design — security is the unguessable filename (contains the VAPI
        call UUID). Used when a workflow's recording.link_from is the S3 destination.
      parameters:
      - in: path
        name: filename
        schema:
          type: string
        description: Self-contained recording filename ({call_id}_{ts}_{assistant_id}_{type}.wav)
        required: true
      tags:
      - workflows
      security:
      - {}
      responses:
        '302':
          description: No response body
        '404':
          description: No response body
components:
  schemas:
    APIToken:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        token:
          type: string
          readOnly: true
        type:
