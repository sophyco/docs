          type: string
          format: date-time
    Payment:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        organization_name:
          type: string
          readOnly: true
        gateway:
          $ref: '#/components/schemas/GatewayEnum'
        amount_cents:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
        currency:
          type: string
          maxLength: 10
        kind:
          $ref: '#/components/schemas/KindEnum'
        status:
          $ref: '#/components/schemas/StatusEnum'
        items:
          description: "\n        Each item:\n        - name: str\n        - kind:
            one-time | recurring\n        - quantity: int\n        - unit_price_cents:
            int (USD source or display currency)\n        - amount_cents: int (unit_price_cents
            * quantity)\n        - currency: str (display only)\n        "
        metadata:
          description: |-
            Payment metadata (copied from SubscriptionPlan.metadata on recurring charges).
            - 'fx': {'from': str, 'to': str, 'rate': float, 'subtotal': int (cents)}
                Present when pricing.base_type == 'rate_based'.
            - 'pricing': {
                'base_type': 'fixed_bundle' | 'rate_based'
                'discount_type': 'none' | 'flat' | 'percentage'
                'discount_cents': int (cents) — source for 'flat'; computed result for 'percentage'
                'discount_percentage': int — only when discount_type == 'percentage'
                'final_amount': int (cents) — equals amount_cents
                'tax_rate': int (percentage, e.g., 20)
            }
        gateway_response: {}
        gateway_events: {}
        expires_at:
          type: string
          format: date-time
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        is_expired:
          type: boolean
          readOnly: true
      required:
      - created_at
      - id
      - is_expired
      - organization_name
