          type: boolean
        type:
          $ref: '#/components/schemas/TypeDffEnum'
        template_name:
          type: string
          nullable: true
          description: Null unless type='template'.
        content:
          type: string
          nullable: true
          description: 'What was sent: the text, the media URL, or for templates the
            rendered body the customer sees.'
        error:
          type: string
          nullable: true
          description: Null when success=true.
        deduplicated:
          type: boolean
          description: True when this client_message_id was already sent; the prior
            result is returned.
