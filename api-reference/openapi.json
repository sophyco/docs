        name: agent_id
        schema:
          type: integer
        description: AI agent's numeric id.
      - in: query
        name: agent_name
        schema:
          type: string
        description: Agent name, case-insensitive substring. Use this when the UI
          has a name rather than an id.
      - in: query
        name: campaign_id
        schema:
          type: string
          format: uuid
      - in: query
        name: campaign_name
        schema:
          type: string
        description: Campaign name, case-insensitive substring.
      - in: query
        name: channel_id
        schema:
          type: string
          format: uuid
      - in: query
        name: channel_name
        schema:
          type: string
        description: Channel name, case-insensitive substring.
      - in: query
        name: contact_id
        schema:
          type: string
          format: uuid
      - in: query
        name: date_from
        schema:
          type: string
          format: date-time
        description: 'Inclusive lower bound on created_at — when the call was recorded.
          Not started_at: a call that never connected has none, and would drop out
          of the range entirely.'
      - in: query
        name: date_to
        schema:
          type: string
          format: date-time
        description: Inclusive upper bound on created_at.
      - in: query
        name: direction
        schema:
          type: string
        description: inbound | outbound
      - in: query
        name: external_ref
        schema:
          type: string
        description: Customer record id a Studio-started call was placed for.
      - in: query
        name: has_recording
        schema:
          type: boolean
      - in: query
        name: initiated_by
        schema:
          type: integer
        description: User who confirmed and started the call in Studio.
      - in: query
        name: limit
        schema:
          type: integer
        description: Max results to return (default 100, max 1000)
      - in: query
        name: number
        schema:
          type: string
        description: Substring match on either number
      - in: query
        name: offset
        schema:
          type: integer
        description: Number of items to skip (default 0)
      - in: query
        name: origin
        schema:
          type: string
        description: inbound | campaign | manual | api
      - in: query
        name: outcome
        schema:
          type: string
      - in: query
        name: platform_type
        schema:
          type: string
      - in: query
        name: run_id
        schema:
          type: string
          format: uuid
      - in: query
        name: state
        schema:
          type: string
